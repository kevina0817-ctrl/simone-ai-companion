# Supabase (client — VITE_ prefix required for browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only (chat / SSR — do not use VITE_ prefix)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI chat (at least one required for Simone concierge)
AGNIC_TOKEN=
LOVABLE_API_KEY=

# Optional: copy AGNIC_TOKEN from backend/.env for local dev, or set in Cloudflare secrets / .dev.vars
