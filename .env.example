# --- Supabase (leave empty for demo mode) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- AI chat (at least one recommended for live concierge) ---
AGNIC_TOKEN=your_token_here
LOVABLE_API_KEY=your_lovable_api_key_here

# --- Optional demo persona when Supabase is not configured ---
VITE_DEMO_PERSONA=jordan
